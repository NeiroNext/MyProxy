{
  "manifest_version": 3,
  "name": "Proxy Manager",
  "version": "1.0",
  "description": "Advanced proxy manager with profiles and domain-specific rules.",
  "permissions": [
    "proxy",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
